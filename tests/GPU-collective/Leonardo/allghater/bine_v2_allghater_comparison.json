{
  "environment": {
    "desc": "Leonardo HPC cluster.",
    "name": "leonardo",
    "slurm": true,
    "python_module": "python/3.11.6--gcc--8.5.0",
    "other_var": {
      "UCX_IB_SL": "1"
    },
    "partition": {
      "environment": "leonardo",
      "desc": "Boost partition with GPU nodes.",
      "name": "boost_usr_prod",
      "is_gpu": true,
      "cpus_per_node": 32,
      "sockets_per_node": 1,
      "gpus_per_node": 4,
      "qos": {
        "partition": "boost_usr_prod",
        "environment": "leonardo",
        "desc": "Default QOS for boost partition.",
        "name": "default",
        "is_required": false,
        "nodes_limit": {
          "min": 2,
          "max": 64
        },
        "time_limit": "24:00:00"
      }
    }
  },
  "test": {
    "compile_only": false,
    "debug_mode": false,
    "dry_run": false,
    "compress": true,
    "delete": true,
    "number_of_nodes": 8,
    "output_level": "minimal",
    "dimensions": {
      "dtype": "int32",
      "sizes_bytes": [
        256,
        16384,
        1048576,
        67108864
      ],
      "sizes_elements": [
        64,
        4096,
        262144,
        16777216
      ],
      "segsizes_bytes": [
        16384,
        131072,
        1048576
      ]
    },
    "test_time": "00:30:00"
  },
  "libraries": [
    {
      "name": "Open MPI 4.1.6",
      "desc": "An open source Message Passing Interface implementation.",
      "tests": {
        "cpu": [
          4
        ],
        "gpu": [
          4
        ]
      },
      "standard": "MPI",
      "lib_type": "Open-MPI",
      "version": "4.1.6",
      "compiler": "mpicc",
      "gpu_support": {
        "gpu": true,
        "gpu_support_native": true,
        "gpu_load": {
          "type": "module",
          "module": "cuda/12.1"
        }
      },
      "lib_load": {
        "type": "module",
        "module": "openmpi/4.1.6--gcc--12.2.0"
      },
      "pico_backend": true,
      "algorithms": {
        "allgather": [
          {
            "name": "bine_block_by_block_hierarcic_global_local_over",
            "coll": "allgather",
            "desc": "libpico external bine block by block algorithm. Works only for power of 2 processes",
            "version": "1.0.0",
            "selection": "pico",
            "constraints": [
              {
                "key": "count",
                "conditions": [
                  {
                    "operator": ">=",
                    "value": "comm_sz"
                  }
                ]
              },
              {
                "key": "comm_sz",
                "conditions": [
                  {
                    "operator": "is_power_of_two",
                    "value": true
                  }
                ]
              }
            ],
            "tags": [
              "bine_block_by_block",
              "block_by_block",
              "bine",
              "external"
            ]
          },
          {
            "name": "bine_send_remap_hierarcic_global_local_over",
            "coll": "allgather",
            "desc": "libpico external bine remap algorithm. Works only for power of 2 processes. Count must be greater or equal to comm_sz. This version remaps rank to allow the sending of contiguous buffers.",
            "version": "1.0.0",
            "selection": "pico",
            "constraints": [
              {
                "key": "comm_sz",
                "conditions": [
                  {
                    "operator": "is_power_of_two",
                    "value": true
                  }
                ]
              },
              {
                "key": "count",
                "conditions": [
                  {
                    "operator": ">=",
                    "value": "comm_sz"
                  }
                ]
              }
            ],
            "tags": [
              "bine_remap",
              "bine",
              "external"
            ]
          },
          {
            "name": "bine_permutation_hierarcic_global_local_over",
            "coll": "allgather",
            "desc": "libpico external bine algorithm. Works only for power of 2 processes. Count must be greater or equal to comm_sz.",
            "version": "1.0.0",
            "selection": "pico",
            "constraints": [
              {
                "key": "comm_sz",
                "conditions": [
                  {
                    "operator": "is_power_of_two",
                    "value": true
                  }
                ]
              },
              {
                "key": "count",
                "conditions": [
                  {
                    "operator": ">=",
                    "value": "comm_sz"
                  }
                ]
              }
            ],
            "tags": [
              "bine",
              "dtype",
              "cuda",
              "external"
            ]
          }
        ]
      }
    }
  ]
}